# =========================
# OS / IDE
# =========================
.DS_Store
Thumbs.db
nul
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
.claude/
CLAUDE.md
AGENTS.md
docs/
.worktrees/

# =========================
# Secrets (NEVER COMMIT)
# =========================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
# 锚定根目录：只拦本地凭证目录，不误伤 src 下的 credentials/vault 源码
/credentials/
/vault/
# tauri-build 需要 gen/schemas 目录存在（内容自动生成），锚定根避免误伤
/gen/

# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.uv-cache/
dist/
build/
*.egg-info/

# =========================
# Node / pnpm
# =========================
node_modules/
.pnpm-store/
.pnpm-debug.log*
yarn-error.log*
.npm/
*.tsbuildinfo
.next/
out/

# =========================
# Rust / Tauri
# =========================
target/
**/target/
**/*.rs.bk
Cargo.lock.bak
src-tauri/target/
**/src-tauri/gen/

# =========================
# Build artifacts
# =========================
*.app
*.dmg
*.exe
*.msi
*.deb
*.rpm
*.AppImage
release/
dist/

# =========================
# Local DB / Audit logs
# =========================
*.sqlite
*.sqlite-journal
*.db
# 仅忽略仓库根的本地审计产物目录；不能误伤 src 下的 audit/credentials 源码目录
/audit/
# 工具结果 spill 落盘目录（运行时产物；锚定根目录避免误伤深层同名目录）
/spill/
logs/
*.log

# =========================
# Local tool configs / caches
# =========================
.claude/
.qoder/

# =========================
# Offline DB driver bundle (regenerated from wheels)
# =========================
config/driver/_site/
config/driver/*.whl

# =========================
# V9 OfficeCLI binary (fetched by infra/scripts/fetch-officecli.ps1)
# =========================
vendor/officecli/officecli-*

# =========================
# PPT Master runtime：2026-09-03 起不再内置（已移出 tauri bundle.resources，PPT 技能
# 改由用户经 /skills/import 自行上传）。/vendor/ppt-master/ 与 /vendor/python/ 保留
# 忽略项，仅为防止旧构建/旧拉取遗留的目录被误提交。
# =========================
/vendor/ppt-master/
/vendor/python/

# =========================
# bge-reranker ONNX 模型（量化版 ~266MB）：由 model/download_bge_reranker_onnx.ps1
# 在开发/打包机拉取，eaide-agent.spec datas 打进安装包（同 officecli 模式）。
# 不入 git（体积大且超 GitHub 100MB 单文件限制）；未下载时 reranker 静默 no-op。
# =========================
/model/bge-reranker-base-onnx/

# =========================
# Tauri generated
# =========================
**/src-tauri/gen/
