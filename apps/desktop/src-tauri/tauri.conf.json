{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Enterprise AI IDE",
  "version": "0.1.3",
  "identifier": "com.eaide.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Enterprise AI IDE",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8765; worker-src blob:; frame-src 'self' asset: http://asset.localhost blob: data:; img-src 'self' asset: http://asset.localhost data: blob:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$HOME/**",
          "$RESOURCE/**",
          "$TEMP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "resources/*": "./",
      "../../../config/driver/*": "./config/driver/",
      "../../../vendor/officecli/*": "./vendor/officecli/",
      "../../../vendor/executor/*": "./vendor/executor/"
    },
    "category": "DeveloperTool",
    "shortDescription": "Enterprise AI IDE",
    "longDescription": "Local AI IDE for querying & orchestrating enterprise systems via natural language.",
    "windows": {
      "nsis": {
        "installerHooks": "hooks/eaide-hooks.nsh"
      }
    }
  }
}
